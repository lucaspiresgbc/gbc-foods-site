{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "static/js/site.js",
    "tests/js/**/*.test.js",
    "e2e/**/*.spec.js"
  ],
  "project": [
    "static/js/**/*.js",
    "tests/js/**/*.js",
    "e2e/**/*.js"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "pytest"
  ]
}
