{
  "name": "gbc-foods-site",
  "version": "2.1.0",
  "private": true,
  "description": "Site institucional GBC Foods — gerador estático em Python; este package.json só traz as ferramentas de qualidade e teste do JavaScript.",
  "type": "module",
  "scripts": {
    "lint": "biome check . && knip && depcruise static/js --config .dependency-cruiser.cjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "commitlint": "commitlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:py": "python3 -m pytest --cov --cov-report=term --cov-report=xml:coverage-python.xml"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@playwright/test": "1.56.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.4.0",
    "happy-dom": "20.14.5",
    "knip": "6.38.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "qs": ">=6.15.4"
  }
}
