{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing do JavaScript do site: o Stryker altera o código (troca >, inverte if, apaga chamadas) e confere se algum teste do Vitest percebe. Score baixo = testes que não testam. Rodar: npx stryker run",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.js"
  },
  "mutate": [
    "static/js/**/*.js",
    "!static/js/site.js"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 70
  },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 20000,
  "tempDirName": ".stryker-tmp",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "disableTypeChecks": "static/js/**/*.js"
}
